# coding: us-ascii
# frozen_string_literal: true

module Eprun
  module <%= attrs[:ucd_version].module_string %>
    module Tables
      accents = "" \
        "[<% each_regexp_chars(attrs[:accent_array]) do |rx| %><%= rx %>" \
        "<% end %>]"
      ACCENTS = accents
      REGEXP_D_STRING = <%# composition starters and composition exclusions %>
        "[<% each_regexp_chars(attrs[:composition_table].values + attrs[:composition_exclusions]) do |rx| %><%= rx %>" \
        "<% end%>]#{accents}*" \
        "|" \<%# characters that can be the result of a composition, except composition starters %>
        "[<% each_regexp_chars(attrs[:composition_starters] - attrs[:composition_table].values) do |rx| %><%= rx %>" \
        "<% end %>]?#{accents}+" \
        "|" \<%# precomposed Hangul syllables %>
        "[\u{AC00}-\u{D7A4}]"
      REGEXP_C_STRING =  <%# composition exclusions %>
        "[<% each_regexp_chars(attrs[:composition_exclusions]) do |rx| %><%= rx %>" \
        "<% end %>]#{accents}*" \
        "|" \<%# composition starters and characters that can be the result of a composition %>
        "[<% each_regexp_chars(attrs[:composition_starters] + attrs[:composition_table].values) do |rx| %><%= rx %>" \
        "<% end %>]?#{accents}+" \
        "|" \<%# Hangul syllables with separate trailer %>
        "[<% each_regexp_chars(attrs[:hangul_no_trailing]) do |rx|%><%=rx%>" \
        "<% end %>][\u11A8-\u11C2]" \
        "|" \<%# decomposed Hangul syllables %>
        "[\u1100-\u1112][\u1161-\u1175][\u11A8-\u11C2]?"
      REGEXP_K_STRING = "" \
        "[<% each_regexp_chars(attrs[:kompatible_table].keys) do |rx| %><%= rx %>" \
        "<% end %>]"

      class_table = {<% attrs[:combining_classes].each do |key, value| %>
        "<%= to_utf8(key) %>"=><%= value %><%=%>,<% end %>
      }
      class_table.default = 0
      CLASS_TABLE = class_table.freeze

      DECOMPOSITION_TABLE = {<% attrs[:decomposition_table].each do |key, value| %>
        "<%= to_utf8(key) %>"=>"<%= to_utf8(value) %>",<% end %>
      }.freeze

      KOMPATIBLE_TABLE = {<% attrs[:kompatible_table].each do |key, value| %>
        "<%= to_utf8(key) %>"=>"<%= to_utf8(value) %>",<% end %>
      }.freeze

      COMPOSITION_TABLE = {<% attrs[:composition_table].each do |key, value| %>
        "<%= to_utf8(key) %>"=>"<%= to_utf8(value) %>",<% end %>
      }.freeze

      class << self
        def class_table
          CLASS_TABLE
        end

        def composition_table
          COMPOSITION_TABLE
        end

        def decomposition_table
          DECOMPOSITION_TABLE
        end

        def kompatible_table
          KOMPATIBLE_TABLE
        end

        def regexp_d_string
          REGEXP_D_STRING
        end

        def regexp_c_string
          REGEXP_C_STRING
        end

        def regexp_k_string
          REGEXP_K_STRING
        end
      end
    end
  end
end
